{
  "name": "hudeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43127",
    "qr": "evenhub qr --url http://127.0.0.1:43127",
    "qr:tunnel": "PORT=43127 bash node_modules/@penta2himajin/even-deskless/scripts/qr-tunnel.sh",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:l0": "npm run typecheck && npm test",
    "verify:l2a": "even-deskless verify-l2a --port 43127",
    "verify:deskless": "npm run verify:l0 && npm run verify:l2a",
    "sim": "evenhub-simulator http://127.0.0.1:43127 --automation-port 9898",
    "pack": "npm run build && evenhub pack app.json dist -o hudeck.ehpk"
  },
  "evenDeskless": {
    "readyMarker": "[hudeck] ready",
    "appUrl": "http://127.0.0.1:43127/"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.14",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.3",
    "@penta2himajin/even-deskless": "^0.1.3",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "ws": "^8.21.3"
  }
}
